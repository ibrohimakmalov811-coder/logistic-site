# ==============================================================================
# LOGISTIKA PLATFORM - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# The project owner creates and connects external accounts.
# Copy this file to .env.local for local development.
# In production (Vercel), enter these variables in Project Settings > Environment Variables.
#
# IMPORTANT SECURITY NOTICE:
# - Never commit real keys or secrets to Git.
# - In development, omitting these keys triggers safe in-memory fallbacks with
#   official Cloudflare Turnstile test keys.
# - In production, missing credentials will strictly throw an error.
# ==============================================================================

# Node Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. CLOUDFLARE TURNSTILE (Bot & Abuse Protection)
# ------------------------------------------------------------------------------
# Where to find: Cloudflare Dashboard > Turnstile > Add Site > Site Key & Secret Key
# Official Cloudflare test keys (always pass in dev mode):
# Site Key: 1x00000000000000000000AA
# Secret Key: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ------------------------------------------------------------------------------
# 2. SUPABASE (Database for Waitlist Submissions with RLS)
# ------------------------------------------------------------------------------
# Where to find: Supabase Dashboard > Project Settings > API
# - NEXT_PUBLIC_SUPABASE_URL: Project URL (e.g. https://xyzcompany.supabase.co)
# - NEXT_PUBLIC_SUPABASE_ANON_KEY: anon / public key (safe for client, strictly insert-only via RLS)
# - SUPABASE_SERVICE_ROLE_KEY: service_role secret (server-only, bypasses RLS for admin checks)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 3. UPSTASH REDIS (Rate Limiting & Abuse Prevention)
# ------------------------------------------------------------------------------
# Where to find: Upstash Console > Redis > Select/Create Database > REST API section
# - UPSTASH_REDIS_REST_URL: UPSTASH_REDIS_REST_URL
# - UPSTASH_REDIS_REST_TOKEN: UPSTASH_REDIS_REST_TOKEN
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token-here

# ------------------------------------------------------------------------------
# 4. SITE DEPLOYMENT URL
# ------------------------------------------------------------------------------
# Set this to your production domain or Vercel deployment URL (e.g. https://logistika.uz)
NEXT_PUBLIC_SITE_URL=https://logistika.uz

# ------------------------------------------------------------------------------
# 5. PRIVACY & DEV SANDBOX SECRETS
# ------------------------------------------------------------------------------
# Cryptographic salt for one-way IP hashing in audit_logs and waitlist
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=change-me-32-byte-random-hex-in-production
# Local development sandbox session signing secret ONLY (never used in production)
AUTH_DEV_SECRET=dev-only-local-sandbox-secret
